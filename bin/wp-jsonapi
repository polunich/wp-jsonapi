declare(strict_types=1);

use Composer\InstalledVersions;
use Polunich\WpJsonApi\Console\OpenApiCommand;

include $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

/**
 * the CLI SAPI sets `$argv` in the global scope alone;
 * `$_SERVER['argv']` carries the same list where this file is included from a function
 *
 * @var list<string> $arguments
 */
$arguments = $argv ?? $_SERVER['argv'] ?? [];

// the root package is the project whose composer.json names its APIs,
// wherever the vendor directory lies and whichever directory the command runs in
$project = InstalledVersions::getRootPackage()['install_path'];

exit((new OpenApiCommand(STDOUT, STDERR, realpath($project) ?: $project, (string) getcwd()))->run($arguments));
